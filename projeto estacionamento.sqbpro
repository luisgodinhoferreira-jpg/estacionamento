-- SISTEMA DE ESTACIONAMENTO - SQLITE (DB Browser)
-- ============================================

-- Apaga as tabelas se já existirem (para evitar erros)
DROP TABLE IF EXISTS pagamentos;
DROP TABLE IF EXISTS estadia;
DROP TABLE IF EXISTS precos;
DROP TABLE IF EXISTS veiculos;
DROP TABLE IF EXISTS clientes;

-- ============================================
-- 1. TABELA CLIENTES
-- ============================================
CREATE TABLE clientes (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    nome VARCHAR(30) NOT NULL,
    fone VARCHAR(20) NOT NULL,
    cpf VARCHAR(14) UNIQUE NOT NULL,
    data_cadastro DATETIME DEFAULT (datetime('now', 'localtime'))
);

-- ============================================
-- 2. TABELA VEICULOS
-- ============================================
CREATE TABLE veiculos (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    placa VARCHAR(10) UNIQUE NOT NULL,
    modelo VARCHAR(50) NOT NULL,
    marca VARCHAR(50) NOT NULL,
    cor VARCHAR(20) NOT NULL,
    cliente_id INTEGER NOT NULL,
    data_cadastro DATETIME DEFAULT (datetime('now', 'localtime')),
    FOREIGN KEY (cliente_id) REFERENCES clientes(id)
);

-- ============================================
-- 3. TABELA PRECOS
-- ============================================
CREATE TABLE precos (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    tipo_veiculo VARCHAR(30) NOT NULL,
    valor_hora DECIMAL(10,2) NOT NULL,
    valor_diaria DECIMAL(10,2) NOT NULL,
    data_cadastro DATETIME DEFAULT (datetime('now', 'localtime'))
);

-- ============================================
-- 4. TABELA ESTADIA
-- ============================================
CREATE TABLE estadia (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    veiculo_id INTEGER NOT NULL,
    horario_entrada DATETIME NOT NULL DEFAULT (datetime('now', 'localtime')),
    horario_saida DATETIME,
    valor_total DECIMAL(10,2),
    status VARCHAR(20) DEFAULT 'Aberto',
    tempo_total_minutos INTEGER,
    FOREIGN KEY (veiculo_id) REFERENCES veiculos(id)
);

-- ============================================
-- 5. TABELA PAGAMENTOS
-- ============================================
CREATE TABLE pagamentos (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    estadia_id INTEGER NOT NULL,
    forma_pagamento VARCHAR(30) NOT NULL,
    valor_pago DECIMAL(10,2) NOT NULL,
    data_pago DATETIME NOT NULL DEFAULT (datetime('now', 'localtime')),
    FOREIGN KEY (estadia_id) REFERENCES estadia(id)
);

-- ============================================
-- INSERIR CLIENTES DE EXEMPLO
-- ============================================
